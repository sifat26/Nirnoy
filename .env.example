# --- Server ---
PORT=4000
NODE_ENV=development

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/mcq-exam
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mcq-exam?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mcq-exam

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account — created/updated when you run `npm run seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Frontend origin, used for CORS in development.
CLIENT_URL=http://localhost:5173

# --- Google Sign-In (optional) ---
# Create an OAuth 2.0 "Web application" Client ID in Google Cloud Console and add
# your origins (http://localhost:5173 and your production URL) to "Authorized
# JavaScript origins". Put the SAME Client ID in both vars below. Leave blank to
# disable Google login (the button simply won't render).
#   GOOGLE_CLIENT_ID       -> backend, verifies the Google ID token
#   VITE_GOOGLE_CLIENT_ID  -> frontend, build-time (Vite only exposes VITE_ vars)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- AI (optional, DISABLED in v1) ---
# Leave blank for now. Providing a key flips on AI feature seams (server/services/ai.js).
ANTHROPIC_API_KEY=
