# --- Server ---
PORT=4000
NODE_ENV=development

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/mcq-exam
#   Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mcq-exam?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mcq-exam

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account — created/updated when you run `npm run seed`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Frontend origin, used for CORS in development.
CLIENT_URL=http://localhost:5173

# --- AI (optional, DISABLED in v1) ---
# Leave blank for now. Providing a key flips on AI feature seams (server/services/ai.js).
ANTHROPIC_API_KEY=
